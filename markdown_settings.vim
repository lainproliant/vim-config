" Don't require links to have ".md" extension in their name.
let g:vim_markdown_no_extensions_in_markdown = 1

" Automatically write changes to file when moving to another file.
let g:vim_markdown_autowrite = 1

" Disable automatic bullet insert and automatic list item indent.
let g:vim_markdown_auto_insert_bullets = 0
let g:vim_markdown_new_list_item_indent = 0

" Allow for borderless tables.
let g:vim_markdown_borderless_table = 1
